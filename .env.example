# Copy to .env and fill in. All optional — site works without them.

# Canonical domain / sitemap base. Override per-deploy (e.g. preview URL).
# Leave unset to use the default target domain in src/config/site.ts.
SITE_URL=https://mangfpt.vn

# Google Analytics 4 (GA4) Measurement ID, e.g. G-ABC123XYZ.
# When set, the gtag.js snippet is injected site-wide.
PUBLIC_GA4_ID=

# Google Ads conversion tracking. ID e.g. AW-123456789, label e.g. abcDEF123.
# Fires a 'conversion' event when the lead form is submitted.
PUBLIC_ADS_ID=
PUBLIC_ADS_LABEL=
