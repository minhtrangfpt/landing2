---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import { analytics } from '../config/site';
import type { Province } from '../config/provinces';
interface Props { province: Province; }
const { province } = Astro.props;
const { ga4Id } = analytics;
---
<!doctype html>
<html lang="vi">
  <head>
    <SEOHead province={province} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    {ga4Id && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script is:inline set:html={`window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments);};gtag('js',new Date());gtag('config','${ga4Id}');`}></script>
      </>
    )}
  </head>
  <body>
    <slot />
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a') : null;
        if (!a || !window.gtag) return;
        var h = a.getAttribute('href') || '';
        if (h.indexOf('tel:') === 0) window.gtag('event', 'phone_click');
        else if (h.indexOf('zalo.me') !== -1) window.gtag('event', 'zalo_click');
      });
    </script>
  </body>
</html>
