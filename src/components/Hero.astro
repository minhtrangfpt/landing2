---
import { site } from '../config/site';
import { getPackagesByGroup } from '../data/packages';
import { formatVnd } from '../lib/format';
import type { Province } from '../config/provinces';
interface Props { province: Province; }
const { province } = Astro.props;
const family = getPackagesByGroup('family');
const minPrice = family.length
  ? formatVnd(Math.min(...family.map((p) => p.priceMonthly)))
  : '195.000đ';
const perks = [
  '🎁 Tặng 1 tháng cước',
  '🎟️ Tặng Voucher tiền mặt 300.000đ',
  '📝 Thủ tục online',
  '⚡ Lắp đặt trong ngày',
];
---
<section class="hero">
  <img
    class="hero__banner"
    src="/hero1.jpg"
    alt={`Lắp mạng FPT tại ${province.name} — Wi-Fi 6, tăng gấp 3 tốc độ. Hotline ${site.phoneDisplay}`}
    width="1600" height="600" loading="eager" fetchpriority="high"
  />
  <div class="container hero__content">
    <h1>{province.heroHeadline}</h1>
    <p class="hero__lead">Tăng gấp 3 tốc độ — Trang bị Modem Wi-Fi 6 mới nhất</p>
    <div class="hero__price">
      <span>Chỉ từ</span>
      <strong>{minPrice}</strong>
      <span>/tháng</span>
    </div>
    <ul class="hero__perks">
      {perks.map((p) => <li>{p}</li>)}
    </ul>
    <div class="hero__cta">
      <a class="btn btn--lg hero__register" href="#dang-ky">📝 Đăng ký nhận ưu đãi</a>
      <a class="btn btn--lg btn--call btn--pulse" href={`tel:${site.phoneRaw}`}>📞 Hotline: {site.phoneDisplay}</a>
    </div>
  </div>
</section>

<style>
.hero { background: var(--orange); color: #fff; }
.hero__banner { width: 100%; height: auto; display: block; }
.hero__content { max-width: 880px; padding: 28px 16px 40px; text-align: center; }
.hero h1 { color: #fff; }
.hero__lead { font-size: clamp(1.05rem, 2.4vw, 1.3rem); font-weight: 700; margin-top: 8px; }
.hero__price { display: inline-flex; align-items: baseline; gap: 6px; background: rgba(255, 255, 255, 0.15); border-radius: var(--radius-sm); padding: 8px 18px; margin: 16px 0 20px; }
.hero__price strong { font-size: 1.6rem; font-weight: 800; }
.hero__perks { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-bottom: 24px; font-weight: 600; font-size: .9rem; }
.hero__perks li { background: rgba(255, 255, 255, 0.15); border-radius: 999px; padding: 6px 12px; }
.hero__cta { display: flex; flex-direction: column; align-items: stretch; gap: 12px; max-width: 420px; margin: 0 auto; }
.hero__register { background: #fff; color: var(--orange-dark); }
.hero__register:hover { background: var(--gray-100); }
@media (min-width: 640px) {
  .hero__cta { flex-direction: row; justify-content: center; max-width: none; }
  .hero__cta .btn { min-width: 260px; }
}
</style>
