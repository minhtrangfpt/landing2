---
import { site, analytics, web3forms } from '../config/site';
import type { Province } from '../config/provinces';
interface Props { province: Province; }
const { province } = Astro.props;
const { adsId, adsLabel } = analytics;
---
<section class="section cta-band" id="dang-ky" aria-labelledby="cta-title">
  <div class="container cta-band__inner">
    <div>
      <h2 id="cta-title">Đăng ký lắp mạng FPT tại {province.name} ngay hôm nay</h2>
      <p>Để lại thông tin hoặc gọi trực tiếp — kỹ thuật viên sẽ liên hệ tư vấn và lắp trong ngày.</p>
    </div>
    <form class="cta-form" id="leadForm" data-mail="trangntm35@fpt.com" data-ads={adsId} data-ads-label={adsLabel} data-w3key={web3forms.key}>
      <input class="cta-form__input" type="text" name="name" placeholder="Họ và tên" required autocomplete="name" />
      <input class="cta-form__input" type="tel" name="phone" placeholder="Số điện thoại" required autocomplete="tel" />
      <button class="btn btn--call" type="submit">Gửi đăng ký ngay</button>
    </form>
  </div>
</section>

<script is:inline>
  document.getElementById('leadForm')?.addEventListener('submit', function (e) {
    e.preventDefault();
    var f = document.getElementById('leadForm');
    var name = f.name.value.trim();
    var phone = f.phone.value.trim();
    var btn = f.querySelector('button[type="submit"]');
    if (window.gtag) {
      window.gtag('event', 'generate_lead');
      var ads = f.dataset.ads;
      if (ads) {
        window.gtag('event', 'conversion', { send_to: ads + (f.dataset.adsLabel ? '/' + f.dataset.adsLabel : '') });
      }
    }
    function mailFallback() {
      var subject = encodeURIComponent('Dang ky lap mang FPT - ' + name + ' - ' + phone);
      var body = encodeURIComponent('Ho va ten: ' + name + '\nSo dien thoai: ' + phone + '\n\nVui long lien he tu van va lap dat trong ngay.');
      window.location.href = 'mailto:' + f.dataset.mail + '?subject=' + subject + '&body=' + body;
    }
    if (!f.dataset.w3key) { mailFallback(); return; }
    if (btn) { btn.disabled = true; btn.dataset.old = btn.textContent; btn.textContent = 'Đang gửi...'; }
    fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({
        access_key: f.dataset.w3key,
        subject: 'Dang ky lap mang FPT - ' + name + ' - ' + phone,
        from_name: 'Website fpt24h.com.vn',
        'Ho va ten': name,
        'So dien thoai': phone
      })
    }).then(function (r) { return r.json(); }).then(function (d) {
      if (d && d.success) {
        if (btn) { btn.textContent = '✓ Đã gửi đăng ký!'; btn.style.background = '#16a34a'; }
        f.reset();
      } else { mailFallback(); }
    }).catch(function () { mailFallback(); }).finally(function () {
      setTimeout(function () {
        if (btn) { btn.disabled = false; btn.textContent = btn.dataset.old || 'Gửi đăng ký ngay'; btn.style.background = ''; }
      }, 4000);
    });
  });
</script>

<style>
.cta-band { background: linear-gradient(135deg, var(--orange), var(--orange-dark)); color: #fff; }
.cta-band__inner { display: grid; gap: 20px; }
.cta-band h2 { color: #fff; }
.cta-band p { color: #fff5ee; }
.cta-form { display: flex; flex-wrap: wrap; gap: 10px; }
.cta-form__input { flex: 1; min-width: 200px; padding: 14px 16px; border-radius: 999px; border: 0; font-size: 1rem; }
.cta-band__direct { display: flex; flex-wrap: wrap; gap: 12px; }
.cta-band .btn--call { background: #fff; color: var(--orange-dark); }
.cta-band__direct .btn--zalo { background: #fff; color: var(--orange-dark); border-color: var(--orange); }
</style>
