---
import { site, analytics } from '../config/site';
const { adsId, adsLabel } = analytics;
---
<dialog id="leadModal" class="leadmodal" aria-labelledby="leadmodal-title">
  <div class="leadmodal__panel">
    <button class="leadmodal__close" type="button" aria-label="Đóng" onclick="document.getElementById('leadModal').close()">✕</button>
    <div class="leadmodal__head">
      <h3 id="leadmodal-title">Đăng ký lắp mạng FPT</h3>
      <p>Quý khách hãy để lại thông tin, kỹ thuật viên sẽ tư vấn và lắp đặt trong ngày. Hotline: {site.phoneDisplay}</p>
    </div>
    <form id="leadModalForm" data-mail="trangntm35@fpt.com" data-ads={adsId} data-ads-label={adsLabel}>
      <input type="text" name="name" placeholder="Họ và tên" required autocomplete="name" />
      <input type="tel" name="phone" placeholder="Số điện thoại" required autocomplete="tel" />
      <button type="submit" class="btn btn--fpt">Gửi đăng ký</button>
    </form>
    <div class="leadmodal__direct">
      <a class="btn btn--call" href={`tel:${site.phoneRaw}`}>📞 Hotline: {site.phoneDisplay}</a>
    </div>
  </div>
</dialog>

<script is:inline>
  (function () {
    var dlg = document.getElementById('leadModal');
    if (!dlg) return;
    window.openLeadForm = function () { try { dlg.showModal(); } catch (e) {} };
    // Open once per session, when the user scrolls near the bottom.
    function fireOnce() {
      try { if (sessionStorage.getItem('leadSeen')) return; } catch (e) { return; }
      try { dlg.showModal(); } catch (e) {}
      try { sessionStorage.setItem('leadSeen', '1'); } catch (e) {}
    }
    window.addEventListener('scroll', function () {
      if ((window.innerHeight + window.scrollY) >= (document.body.scrollHeight - 300)) fireOnce();
    });
    var f = document.getElementById('leadModalForm');
    if (f) f.addEventListener('submit', function (e) {
      e.preventDefault();
      var name = f.name.value.trim(), phone = f.phone.value.trim();
      if (window.gtag) {
        window.gtag('event', 'generate_lead');
        var ads = f.dataset.ads;
        if (ads) window.gtag('event', 'conversion', { send_to: ads + (f.dataset.adsLabel ? '/' + f.dataset.adsLabel : '') });
      }
      var subject = encodeURIComponent('Dang ky lap mang FPT - ' + name + ' - ' + phone);
      var body = encodeURIComponent('Ho va ten: ' + name + '\nSo dien thoai: ' + phone + '\n\nVui long lien he tu van va lap dat trong ngay.');
      window.open('mailto:' + f.dataset.mail + '?subject=' + subject + '&body=' + body, '_self');
      try { dlg.close(); } catch (e) {}
    });
  })();
</script>

<style>
.leadmodal { border: 0; padding: 0; background: transparent; max-width: min(92vw, 420px); width: 100%; color: var(--ink); }
.leadmodal::backdrop { background: rgba(11, 44, 93, 0.72); }
.leadmodal__panel { position: relative; background: #fff; border-radius: var(--radius); padding: 28px 22px 22px; box-shadow: var(--shadow-lg); }
.leadmodal__close { position: absolute; top: 10px; right: 10px; width: 32px; height: 32px; border-radius: 50%; border: 0; background: var(--bg-soft); color: var(--navy); font-weight: 800; cursor: pointer; }
.leadmodal__head h3 { margin-bottom: 4px; }
.leadmodal__head p { color: var(--muted); font-size: .9rem; margin-bottom: 16px; }
.leadmodal form { display: flex; flex-direction: column; gap: 10px; }
.leadmodal input { padding: 12px 14px; border-radius: var(--radius-sm); border: 1px solid var(--line); font-size: 1rem; font-family: inherit; }
.leadmodal input:focus { outline: 2px solid var(--orange); border-color: var(--orange); }
.leadmodal form .btn { width: 100%; }
.leadmodal__direct { margin-top: 12px; }
.leadmodal__direct .btn { width: 100%; }
</style>
