---
import { getPackagesByGroup } from '../data/packages';
import { formatVnd } from '../lib/format';
import { site } from '../config/site';
const gamers = getPackagesByGroup('gamer');
---
<section class="section section--soft" id="game-thu" aria-labelledby="gamer-title">
  <div class="container">
    <div class="section__head">
      <h2 id="gamer-title">Gói Internet cho game thủ</h2>
      <p>Tối ưu độ trễ, băng thông lớn cho chơi game và livestream.</p>
    </div>
    <div class="gamer-carousel" data-carousel>
      <button class="pkg-nav pkg-nav--prev" type="button" aria-label="Gói trước" data-prev>‹</button>
      <button class="pkg-nav pkg-nav--next" type="button" aria-label="Gói sau" data-next>›</button>
      <div class="gamer-grid" data-track>
        {gamers.map((g) => (
          <article class:list={['card', 'gamer', { 'gamer--hl': g.highlight }]}>
            {g.badge && <span class="badge gamer__badge">{g.badge}</span>}
            <img class="gamer__img" src={g.image} alt={g.name} loading="lazy" />
            <h3>{g.name}</h3>
            {g.speed && <p class="gamer__speed">{g.speed}</p>}
            <div class="gamer__price">
              <span class="gamer__amount">{formatVnd(g.priceMonthly)}</span>
              <span class="gamer__unit">/tháng</span>
            </div>
            <ul class="gamer__features">
              {g.features.slice(0, 3).map((f) => <li>✓ {f}</li>)}
            </ul>
            <button class="btn btn--soft gamer__detail" type="button" onclick={`document.getElementById('dlg-${g.id}').showModal()`}>Xem chi tiết</button>
            <a class="btn btn--fpt" href="#dang-ky">Đăng ký {g.name}</a>
            <dialog id={`dlg-${g.id}`} class="gamer__dlg" aria-label={`Chi tiết ${g.name}`}>
              <div class="gamer__dlg-inner">
                <img src={g.detailImage} alt={`Chi tiết ${g.name}`} />
                <button class="gamer__close" type="button" autofocus onclick={`document.getElementById('dlg-${g.id}').close()`}>✕</button>
              </div>
            </dialog>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function init() {
      document.querySelectorAll('[data-carousel]').forEach(function (c) {
        if (c.__pkgInit) return;
        c.__pkgInit = true;
        var track = c.querySelector('[data-track]');
        var prev = c.querySelector('[data-prev]');
        var next = c.querySelector('[data-next]');
        if (!track) return;
        function centerCard(card) {
          if (!card) return;
          var tr = track.getBoundingClientRect();
          var cr = card.getBoundingClientRect();
          var delta = (cr.left - tr.left) - (tr.width - cr.width) / 2;
          track.scrollBy({ left: delta, behavior: 'smooth' });
        }
        function centeredIndex() {
          var mid = track.getBoundingClientRect().left + track.clientWidth / 2;
          var best = 0, bd = Infinity;
          Array.prototype.forEach.call(track.children, function (ch, i) {
            var d = Math.abs((ch.getBoundingClientRect().left + ch.offsetWidth / 2) - mid);
            if (d < bd) { bd = d; best = i; }
          });
          return best;
        }
        if (prev) prev.addEventListener('click', function () { centerCard(track.children[Math.max(0, centeredIndex() - 1)]); });
        if (next) next.addEventListener('click', function () { centerCard(track.children[Math.min(track.children.length - 1, centeredIndex() + 1)]); });
        if ('IntersectionObserver' in window) {
          var hinted = false;
          var mq = window.matchMedia('(max-width: 768px)');
          var io = new IntersectionObserver(function (es) {
            es.forEach(function (e) {
              if (e.isIntersecting && !hinted && mq.matches && track.children[1]) {
                hinted = true;
                setTimeout(function () { centerCard(track.children[1]); }, 350);
              }
            });
          }, { threshold: 0.4 });
          io.observe(c);
        }
      });
    }
    if (document.readyState !== 'loading') init();
    else document.addEventListener('DOMContentLoaded', init);
  })();
</script>

<style>
.gamer-carousel { position: relative; }
.pkg-nav { display: none; }
.gamer-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
.gamer { padding: 16px; display: flex; flex-direction: column; position: relative; }
.gamer--hl { border: 2px solid var(--orange); }
.gamer__badge { position: absolute; top: 10px; right: 10px; z-index: 2; }
.gamer__img { width: 100%; aspect-ratio: 13 / 8; object-fit: cover; border-radius: var(--radius-sm); margin-bottom: 10px; background: var(--bg-soft); }
.gamer h3 { margin-bottom: 2px; }
.gamer__speed { color: var(--muted); font-size: .85rem; }
.gamer__price { margin: 8px 0 12px; }
.gamer__amount { font-size: 1.4rem; font-weight: 900; color: var(--orange); }
.gamer__unit { color: var(--muted); }
.gamer__features { display: flex; flex-direction: column; margin: 6px 0 12px; color: var(--muted); font-size: .85rem; flex: 1; }
.gamer__features li { line-height: 1.5; margin-bottom: 4px; }
.gamer__detail { width: 100%; margin-bottom: 8px; }
.gamer .btn--fpt { width: 100%; }
.gamer__dlg { border: 0; padding: 0; background: transparent; max-width: min(92vw, 760px); }
.gamer__dlg::backdrop { background: rgba(11, 44, 93, 0.72); }
.gamer__dlg-inner { position: relative; }
.gamer__dlg img { display: block; width: 100%; height: auto; border-radius: var(--radius); }
.gamer__close { position: absolute; top: 8px; right: 8px; width: 36px; height: 36px; border-radius: 50%; border: 0; background: rgba(0, 0, 0, 0.6); color: #fff; font-weight: 800; cursor: pointer; }
@media (max-width: 1000px) { .gamer-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 768px) {
  .gamer-grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 16px; align-items: stretch; padding: 8px 4px 16px; margin: 0 -4px; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  .gamer-grid::-webkit-scrollbar { display: none; }
  .gamer-grid > .gamer { flex: 0 0 80%; min-width: 80%; scroll-snap-align: center; }
  .pkg-nav { display: grid; place-items: center; position: absolute; top: 44%; transform: translateY(-50%); z-index: 5; width: 38px; height: 52px; border: 0; background: rgba(255,255,255,.96); color: var(--orange-dark); font-size: 1.7rem; font-weight: 800; line-height: 1; border-radius: 8px; box-shadow: var(--shadow-lg); cursor: pointer; padding: 0; }
  .pkg-nav:active { background: var(--orange-light); }
  .pkg-nav--prev { left: -6px; }
  .pkg-nav--next { right: -6px; }
}
</style>
