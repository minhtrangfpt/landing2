---
import { getPackagesByGroup } from '../data/packages';
import { formatVnd } from '../lib/format';
import { site } from '../config/site';
const gamers = getPackagesByGroup('gamer');
---
<section class="section section--soft" id="game-thu" aria-labelledby="gamer-title">
  <div class="container">
    <div class="section__head">
      <h2 id="gamer-title">Gói Internet cho game thủ</h2>
      <p>Tối ưu độ trễ, băng thông lớn cho chơi game và livestream.</p>
    </div>
    <div class="gamer-carousel" data-carousel>
      <button class="pkg-nav pkg-nav--prev" type="button" aria-label="Gói trước" data-prev>‹</button>
      <button class="pkg-nav pkg-nav--next" type="button" aria-label="Gói sau" data-next>›</button>
      <div class="gamer-grid" data-track>
        {gamers.map((g) => (
          <article class:list={['card', 'pkg', 'gamer', { 'pkg--hl': g.highlight }]}>
            {g.highlight && g.badge && (
              <span class="pkg__hot"><svg class="pkg__hot-flame" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z"/></svg>{g.badge}</span>
            )}
            {!g.highlight && g.badge && <span class="badge gamer__badge">{g.badge}</span>}
            {g.image && <img class="pkg__img gamer__img" src={g.image} alt={g.name} loading="lazy" />}
            <div class="pkg__body">
              <h3>{g.name}</h3>
              <div class="pkg__price">
                <span class="pkg__amount">{formatVnd(g.priceMonthly)}</span>
                <span class="pkg__unit">/tháng</span>
              </div>
              {g.speed && <span class="pkg-speed-pill">{g.speed}</span>}
              <ul class="pkg__features">
                {g.features.slice(0, 3).map((f) => <li>✓ {f}</li>)}
              </ul>
              <div class="pkg__btns">
                <a class="btn btn--fpt btn-block" href="#dang-ky" onclick="event.preventDefault();window.openLeadForm&&window.openLeadForm()">Đăng ký {g.name}</a>
                {g.detailImage && (
                  <button class="btn btn--soft btn-block pkg__detail-btn" type="button" onclick={`document.getElementById('dlg-${g.id}').showModal()`}>Xem chi tiết</button>
                )}
              </div>
            </div>
            {g.detailImage && (
              <dialog id={`dlg-${g.id}`} class="pkg__dlg" aria-label={`Chi tiết ${g.name}`}>
                <div class="pkg__dlg-inner">
                  <button class="pkg__close" type="button" autofocus onclick={`document.getElementById('dlg-${g.id}').close()`} aria-label="Đóng">✕</button>
                  <img src={g.detailImage} alt={`Chi tiết ${g.name}`} />
                </div>
              </dialog>
            )}
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function init() {
      document.querySelectorAll('[data-carousel]').forEach(function (c) {
        if (c.__pkgInit) return;
        c.__pkgInit = true;
        var track = c.querySelector('[data-track]');
        var prev = c.querySelector('[data-prev]');
        var next = c.querySelector('[data-next]');
        if (!track) return;
        function centerCard(card) {
          if (!card) return;
          var tr = track.getBoundingClientRect();
          var cr = card.getBoundingClientRect();
          var delta = (cr.left - tr.left) - (tr.width - cr.width) / 2;
          track.scrollBy({ left: delta, behavior: 'smooth' });
        }
        function centeredIndex() {
          var mid = track.getBoundingClientRect().left + track.clientWidth / 2;
          var best = 0, bd = Infinity;
          Array.prototype.forEach.call(track.children, function (ch, i) {
            var d = Math.abs((ch.getBoundingClientRect().left + ch.offsetWidth / 2) - mid);
            if (d < bd) { bd = d; best = i; }
          });
          return best;
        }
        if (prev) prev.addEventListener('click', function () { centerCard(track.children[Math.max(0, centeredIndex() - 1)]); });
        if (next) next.addEventListener('click', function () { centerCard(track.children[Math.min(track.children.length - 1, centeredIndex() + 1)]); });
        if ('IntersectionObserver' in window) {
          var hinted = false;
          var mq = window.matchMedia('(max-width: 768px)');
          var io = new IntersectionObserver(function (es) {
            es.forEach(function (e) {
              if (e.isIntersecting && !hinted && mq.matches && track.children[1]) {
                hinted = true;
                setTimeout(function () { centerCard(track.children[1]); }, 350);
              }
            });
          }, { threshold: 0.4 });
          io.observe(c);
        }
      });
    }
    if (document.readyState !== 'loading') init();
    else document.addEventListener('DOMContentLoaded', init);
  })();
</script>

<style>
.gamer-carousel { position: relative; }
.pkg-nav { display: none; }
.gamer-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: stretch; }
.gamer { padding: 0; display: flex; flex-direction: column; position: relative; overflow: visible; }
.gamer__badge { position: absolute; top: 12px; right: 12px; z-index: 2; }
.gamer__img { border-radius: var(--radius) var(--radius) 0 0; }
@media (max-width: 900px) { .gamer-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 768px) {
  .gamer-grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 16px; align-items: stretch; padding: 8px 4px 16px; margin: 0 -4px; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  .gamer-grid::-webkit-scrollbar { display: none; }
  .gamer-grid > .gamer { flex: 0 0 84%; min-width: 84%; scroll-snap-align: center; }
  .pkg-nav { display: grid; place-items: center; position: absolute; top: 44%; transform: translateY(-50%); z-index: 5; width: 38px; height: 52px; border: 0; background: rgba(255,255,255,.96); color: var(--orange-dark); font-size: 1.7rem; font-weight: 800; line-height: 1; border-radius: 8px; box-shadow: var(--shadow-lg); cursor: pointer; padding: 0; }
  .pkg-nav:active { background: var(--orange-light); }
  .pkg-nav--prev { left: -6px; }
  .pkg-nav--next { right: -6px; }
}
</style>
