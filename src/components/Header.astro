---
import { site } from '../config/site';
import type { Province } from '../config/provinces';
interface Props { province: Province; }
const { province } = Astro.props;
---
<header class="hdr">
  <div class="container hdr__row">
    <a href="/" class="hdr__brand" aria-label={`${site.brand} ${province.name}`}>
      <img class="hdr__logo-img" src="/logo-fpt.png" alt="FPT Telecom" />
    </a>
    <a class="btn btn--call btn--pulse hdr__hotline" href={`tel:${site.phoneRaw}`}>📞 Hotline: {site.phoneDisplay}</a>
  </div>
</header>

<style>
.hdr { position: sticky; top: 0; z-index: 50; background: #fff; border-bottom: 1px solid var(--line); box-shadow: var(--shadow); }
.hdr__row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 16px; }
.hdr__brand { display: flex; align-items: center; }
.hdr__logo-img { height: 40px; width: auto; display: block; }
.hdr__hotline { padding: 10px 18px; font-size: .95rem; font-weight: 700; flex: none; }
@media (max-width: 480px) {
  .hdr__hotline { padding: 8px 13px; font-size: .82rem; }
  .hdr__logo-img { height: 34px; }
}
</style>
